# Copy to .env and fill in. Never commit .env.

AWS_REGION=us-west-2

# Bedrock model used by the Strands agents
AFTERMATH_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# Optional: Bedrock AgentCore
AGENTCORE_RUNTIME_ARN=
AGENTCORE_MEMORY_ID=

# Outbound messaging for the tracker agent (institution chasing).
# Left blank in the demo — Aftermath never sends anything without human approval.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
